{erl_opts, [debug_info, warnings_as_errors, {i, "src"}]}.
{base_dir, "../../../build/rebar3"}.

{deps, []}.

{dialyzer, [
    {warnings, [unknown, unmatched_returns, error_handling]},
    {get_warnings, true},
    {plt_apps, top_level_deps},
    {base_plt_apps, [erts, kernel, stdlib]},
    {base_plt_location, local},
    {plt_location, local},
    incremental
]}.

{profiles, [
    {nix, [
        {plugins, [
            {rebar3_nix, ".*",
                {git, "https://github.com/erlang-nix/rebar3_nix.git", {tag, "v0.1.1"}}}
        ]}
    ]}
]}.
